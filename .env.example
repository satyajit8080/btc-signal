# ---- required ----
POSTGRES_PASSWORD=change-me
BTCS_ADMIN_TOKEN=change-me-to-a-long-random-string
# Browser-facing API URL baked into the frontend build
PUBLIC_API_URL=http://localhost:8000
BTCS_CORS_ORIGINS=http://localhost:3000

# ---- engine ----
BTCS_CYCLE_SECONDS=60
BTCS_SIGNAL_RECORD_SECONDS=300
BTCS_LIQUIDATION_STREAM=true
BTCS_ESPLORA_URLS=https://mempool.space/api,https://blockstream.info/api
BTCS_HYPERLIQUID_TOP_N=50

# ---- optional provider keys (adapter stays "unconfigured" when empty) ----
BTCS_COINGLASS_API_KEY=
BTCS_WHALE_ALERT_API_KEY=
BTCS_CRYPTOQUANT_API_KEY=
BTCS_GLASSNODE_API_KEY=
BTCS_ETHERSCAN_API_KEY=
BTCS_DUNE_API_KEY=
# JSON list mapping saved Dune queries to canonical metrics, e.g.
# [{"query_id":123456,"metric":"EXCHANGE_NETFLOW_BTC","date_col":"day","value_col":"netflow_btc"}]
BTCS_DUNE_QUERIES=[]
